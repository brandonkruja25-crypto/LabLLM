# Copia questo file in .env (Copy-Item .env.example .env). Nessuna credenziale: LM Studio non la richiede.

# Indirizzo del server di LM Studio (in Docker Compose viene sostituito da host.docker.internal)
LMSTUDIO_BASE_URL=http://localhost:1234/v1
# Identificativo del modello: usa un id restituito da GET /v1/models
LMSTUDIO_MODEL=google/gemma-4-e2b

# Facoltative
FUSO_ORARIO_PREDEFINITO=Europe/Rome
MAX_PASSAGGI=6
# DEBUG, INFO, WARNING o ERROR
LIVELLO_LOG=WARNING
